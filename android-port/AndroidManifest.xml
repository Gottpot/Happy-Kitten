<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.gottpot.happykitten">

    <!-- Kein Netzwerk, keine Berechtigungen: Dateien kommen über die System-Dateiauswahl,
         Exporte gehen über MediaStore in die Galerie (ab Android 10 ohne Berechtigung). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="false" />

    <application
        android:label="Happy-Kitten"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|density|uiMode|navigation"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="happy_kitten" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
